# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Configuration
# Generate a secret via: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your_random_auth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Keycloak OpenID Connect Configuration
# In Keycloak: Create client "monev-app", enable Client authentication (Confidential)
AUTH_KEYCLOAK_ID="monev-app"
AUTH_KEYCLOAK_SECRET="your_client_secret_from_keycloak"
AUTH_KEYCLOAK_ISSUER="https://your-keycloak-domain/realms/your-realm"
